        <packageUrl regex="true">^pkg:maven/org\.springframework/spring-(aop|beans|context|core|expression|jcl|web|webmvc)@6\.2\.19$</packageUrl>
        <cve>CVE-2026-59283</cve>
    </suppress>
    <suppress>
        <notes><![CDATA[Spring MVC functional SSE stream corruption — not applicable: LodView does not use Server-Sent Events]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework/spring-(aop|beans|context|core|expression|jcl|web|webmvc)@6\.2\.19$</packageUrl>
        <cve>CVE-2026-59313</cve>
    </suppress>

</suppressions>

<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!-- Apache Jena Fuseki server-side vulnerabilities: path traversal in admin dataset creation.
         LodView uses Jena only as a SPARQL *client* library, not as a Fuseki server.
         These CVEs do not apply. Upgrade to Jena 5.x deferred (breaking changes). -->
    <suppress>
        <notes><![CDATA[Fuseki server path traversal — not applicable: LodView is a SPARQL client, not a Fuseki server]]></notes>
        <cve>CVE-2025-50151</cve>
    </suppress>
    <suppress>
        <notes><![CDATA[Fuseki server path traversal (dbName) — not applicable: LodView is a SPARQL client, not a Fuseki server]]></notes>
        <cve>CVE-2025-49656</cve>
    </suppress>

    <!-- Log4j Socket Appender TLS hostname verification bypass.
         LodView does not use Socket Appender for logging (only console/file). -->
    <suppress>
        <notes><![CDATA[Log4j Socket Appender TLS issue — not applicable: LodView does not use Socket Appender]]></notes>
        <cve>CVE-2025-68161</cve>
    </suppress>

    <!-- protobuf-java 3.25.x DoS via crafted messages.
         Fix only available in 4.x line; Jena 4.10.0 requires 3.x.
         LodView does not process untrusted protobuf input (only SPARQL/RDF). -->
    <suppress>
        <notes><![CDATA[protobuf-java DoS — not exploitable: LodView does not process untrusted protobuf messages]]></notes>
        <cve>CVE-2026-0994</cve>
    </suppress>

    <!-- jQuery 1.12.4 bundled in static resources. Upgrade to 3.x deferred to future session
         (requires testing all JSP templates and JavaScript interactions). -->
    <suppress>
        <notes><![CDATA[jQuery 1.12.4 — upgrade deferred to future session]]></notes>
        <cve>CVE-2015-9251</cve>
    </suppress>
    <suppress>
        <notes><![CDATA[jQuery 1.12.4 — upgrade deferred to future session]]></notes>
        <cve>CVE-2019-11358</cve>
    </suppress>
    <suppress>
        <notes><![CDATA[jQuery 1.12.4 — upgrade deferred to future session]]></notes>
        <cve>CVE-2020-11022</cve>
    </suppress>
    <suppress>
        <notes><![CDATA[jQuery 1.12.4 — upgrade deferred to future session]]></notes>
        <cve>CVE-2020-11023</cve>
    </suppress>

    <!-- Apache HttpComponents Core 5.5 GA (resolved in the scanned 'spotbugs' configuration via spotbugs -> Saxon-HE -> xmlresolver):
         NVD CPE false positives — both CVEs affect <= 5.4.2 and <= 5.5-beta1 and are fixed in 5.5 GA. -->
    <suppress>
        <notes><![CDATA[httpcore5 5.5 GA false positive — fixed in 5.5 final (affects <= 5.5-beta1)]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.httpcomponents\.core5/httpcore5(-h2)?@5\.5$</packageUrl>
        <cve>CVE-2026-54399</cve>
    </suppress>
    <suppress>
        <notes><![CDATA[httpcore5 5.5 GA false positive — fixed in 5.5 final (affects <= 5.5-beta1)]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.httpcomponents\.core5/httpcore5(-h2)?@5\.5$</packageUrl>
        <cve>CVE-2026-54428</cve>
    </suppress>

    <!-- Spring Framework 6.2.19 (final OSS release of 6.2.x; Spring Boot 4.x upgrade deferred).
         Scoped strictly to the 8 Spring artifacts at version 6.2.19 flagged by OWASP Dependency-Check.
         None of the affected modules/features are used by LodView. -->
    <suppress>
        <notes><![CDATA[Spring MVC XsltView SSRF/RCE — not applicable: LodView uses JSP/JSTL views, not XsltView]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework/spring-(aop|beans|context|core|expression|jcl|web|webmvc)@6\.2\.19$</packageUrl>
        <cve>CVE-2026-47884</cve>
    </suppress>
    <suppress>
        <notes><![CDATA[Spring WebFlux PartEventHttpMessageReader — not applicable: LodView is a Servlet/Spring MVC app, not WebFlux]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework/spring-(aop|beans|context|core|expression|jcl|web|webmvc)@6\.2\.19$</packageUrl>
        <cve>CVE-2026-47885</cve>
    </suppress>
    <suppress>
        <notes><![CDATA[SpEL power operator DoS — not applicable: LodView does not evaluate user-supplied SpEL expressions]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework/spring-(aop|beans|context|core|expression|jcl|web|webmvc)@6\.2\.19$</packageUrl>
        <cve>CVE-2026-47886</cve>
    </suppress>
    <suppress>
        <notes><![CDATA[Spring RSocket SETUP frame memory leak — not applicable: LodView does not use RSocket]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework/spring-(aop|beans|context|core|expression|jcl|web|webmvc)@6\.2\.19$</packageUrl>
        <cve>CVE-2026-47888</cve>
    </suppress>
    <suppress>
        <notes><![CDATA[Spring WebFlux Jetty 12 cookie SameSite — not applicable: LodView runs on Tomcat with Servlet MVC]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework/spring-(aop|beans|context|core|expression|jcl|web|webmvc)@6\.2\.19$</packageUrl>
        <cve>CVE-2026-47889</cve>
    </suppress>
    <suppress>
        <notes><![CDATA[Spring MVC/WebFlux SSE view fragment stream corruption — not applicable: LodView does not use Server-Sent Events]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework/spring-(aop|beans|context|core|expression|jcl|web|webmvc)@6\.2\.19$</packageUrl>
        <cve>CVE-2026-47890</cve>
    </suppress>
    <suppress>
        <notes><![CDATA[Spring WebFlux Aalto XML maxInMemorySize — not applicable: LodView does not use WebFlux or Aalto XML]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework/spring-(aop|beans|context|core|expression|jcl|web|webmvc)@6\.2\.19$</packageUrl>
        <cve>CVE-2026-47891</cve>
    </suppress>
    <suppress>
        <notes><![CDATA[Spring WebFlux functional endpoints pre-flight bypass — not applicable: LodView does not use WebFlux]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework/spring-(aop|beans|context|core|expression|jcl|web|webmvc)@6\.2\.19$</packageUrl>
        <cve>CVE-2026-47892</cve>
    </suppress>
    <suppress>
        <notes><![CDATA[Spring WebFlux WebSocket header disclosure — not applicable: LodView does not use WebFlux WebSockets]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework/spring-(aop|beans|context|core|expression|jcl|web|webmvc)@6\.2\.19$</packageUrl>
        <cve>CVE-2026-47893</cve>
    </suppress>
    <suppress>
        <notes><![CDATA[Spring data binding self-populating List DoS — not applicable: LodView does not bind untrusted nested list paths]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework/spring-(aop|beans|context|core|expression|jcl|web|webmvc)@6\.2\.19$</packageUrl>
        <cve>CVE-2026-59282</cve>
    </suppress>
    <suppress>
